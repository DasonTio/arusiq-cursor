{
  "name": "vite-aircon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "verify": "node tools/verify.mjs",
    "verify:contrast": "node tools/verify-contrast.mjs",
    "verify:tokens": "node tools/verify-tokens.mjs",
    "verify:provenance": "node tools/verify-provenance.mjs",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "trace": "node tools/verify-traceability.mjs",
    "trace:strict": "node tools/verify-traceability.mjs --strict"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
